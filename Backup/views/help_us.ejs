<% layout("layouts/boilerplate") -%>

    <div class="container my-5">
        <form action="/help_us" method="POST">
            <div class="row">
                <div class="col-md-6 offset-md-3 mb-3">
                    <h5 class="fs-1">Help Us</h5>
                </div>

                <div class="col-md-6 offset-md-3 mb-3 form-floating">
                    <input required type="text" name="name" class="form-control" id="name" placeholder="Name">
                    <label for="name" class="form-label mx-3">Name</label>
                </div>

                <div class="col-md-6 offset-md-3 mb-3 form-floating">
                    <input required type="email" name="email" class="form-control" id="input_email" placeholder="Email">
                    <label for="input_email" class="form-label mx-3">Email</label>
                </div>

                <div class="col-md-6 offset-md-3 mb-3 form-floating">
                    <input required type="tel" name="mobile" class="form-control" id="input_number" pattern="[0-9]{10}"
                        minlength="10" maxlength="10" placeholder="Mobile Number">
                    <label for="input_number" class="form-label mx-3">Mobile Number</label>
                </div>

                <div class="col-md-6 offset-md-3 mb-3 form-floating">
                    <select class="form-select" name="helper_type" id="helper_type">
                        <option value="seller">Listing your books</option>
                        <option value="delivery">Helping us with delivery</option>
                        <option value="website">In maintaining our website</option>
                    </select>
                    <label for="helper_type" class="form-label mx-3">In which way can you help us?</label>
                </div>
                <div class="col-md-6 offset-md-3 mt-4 mb-3 d-flex justify-content-center">
                    <button class="btn btn-primary">Yes, I will help.</button>
                </div>
            </div>
        </form>
    </div>

    