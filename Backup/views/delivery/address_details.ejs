<% layout("layouts/boilerplate") -%>

    <div class="container d-flex justify-content-center my-5">
        <form action="/address_details" method="post">
            <div class="card card bg-dark text-white">
                <div class="card-body bg-dark d-grid gap-3">
                    <h5 class="card-title fs-1">Add Address</h5>
                    <p class="card-text">Where would you like us to deliver your order?</p>
                </div>
                <div class="card-body bg-dark d-grid gap-4">
                    <div class="d-grid gap-0">
                        <label for="name" class="form-label">Enter Name</label>
                        <input type="text" name="name" class="form-control" id="name" required>
                    </div>
                    <div class="d-grid gap-0">
                        <label for="InputNumber" class="form-label text-start">Enter Mobile Number</label>
                        <input required type="tel" name="mobile" class="form-control" id="InputNumber"
                            pattern="[0-9]{10}" minlength="10" maxlength="10">
                    </div>
                    <div class="d-grid gap-0">
                        <label for="room_no" class="form-label">Enter Room Number</label>
                        <input type="number" name="room_no" class="form-control mb-1" id="room_no" maxlength="3"
                            required>
                        <p class="card-text text-end text-secondary">Max Room No. 750</p>
                    </div>
                    <div class="d-grid gap-0">
                        <label for="hostel_name" class="form-label">Select Hostel</label>
                        <select class="form-select" name="hostel_name" class="hostel_name" id="hostel_name" required>
                            <option value="TH">Tilak Hostel</option>
                            <option value="PH">Patel Hostel</option>
                            <option value="MH">Malviya Hostel</option>
                        </select>
                    </div>
                    <button class="btn btn-primary">Place Order</button>
                </div>
            </div>
        </form>
    </div>
    <div class="container my-5 d-flex flex-column">
        <p class="lead text-white text-center">We would love to deliver to your hostel/location, even if it's not on our
            list yet! </p>
        <p class="lead text-white text-center">We're always looking to expand our reach and serve more students, so why
            not join our team and help us make that happen?</p>
        <p class="lead text-white text-center">Just click on <a href="/join_us">"Join Us!"</a> and start your journey
            with us today.</p>
        <p class="lead text-white text-center">We can't wait to work together with you!</p>
    </div>
    <script src="/js/delivery.js"></script>