<% layout("layouts/boilerplate") -%>

<h4 class="text-center text-white">Order Confirmation</h4>
        <div class="container bg-dark text-white d-flex justify-content-center">
            <div class="container order d-flex justify-content-center flex-column flex-md-row m-4">
                <div class="container-md-fluid d-flex justify-content-center my-2">
                    <img src="/resources/thumbnail.jpg" alt="productImage">
                </div>
                <div class="flex-grow-1 mx-3 my-3">
                    <div class="order-header">
                        <p class="order-id">OrderId</p>
                        <p class="order-status">Processing</p>
                    </div>
                    <div class="order-details">
                        <p class="product-name">Product Name</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="containe text-center text-white">
            <p>Hooray Payment Recieved</p>
        </div>
        <div class="containe text-center text-white">
            <p>Stay tight</p>
            <p>We will deliver you order within 3days</p>

        