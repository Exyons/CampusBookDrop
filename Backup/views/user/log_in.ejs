<% layout("layouts/boilerplate") -%>

  <div class="container my-5">
    <form action="/log_in" method="POST">
      <div class="row">
        <div class="col-12 col-md-6 offset-md-3 mb-3">
          <h5 class="card-header fs-1">Log In</h5>
        </div>

        <div class="col-12 col-md-6 offset-md-3 mb-3 form-floating">

          <input type="email" name="email" class="form-control" id="inputEmail" aria-describedby="emailHelp"
            placeholder="Email">
          <label for="inputEmail" class="form-label mx-3">Email</label>
        </div>

        <div class="col-12 col-md-6 offset-md-3 mb-3 form-floating">
          <input type="password" name="password" id="InputPassword" class="form-control"
            aria-labelledby="passwordHelpInline" placeholder="Password">
          <label for="InputPassword" class="form-label mx-3">Password</label>
        </div>
      </div>
      <div class="col-12 col-md-6 offset-md-3 mb-3 d-flex flex-row-reverse">
        <a href="#">Forgot Password?</a>
      </div>
      <div class="col-12 col-md-6 offset-md-3 mb-3 d-flex justify-content-center">
        <button class="btn btn-primary">Sign In</button>
      </div>

      <div class="col-12 col-md-6 offset-md-3 mt-5 mb-3 d-flex justify-content-center">
        <span>Don't have an account?</span>
        <a href="/sign_up" class="mx-2">Sign Up</a>
      </div>
    </form>
  </div>