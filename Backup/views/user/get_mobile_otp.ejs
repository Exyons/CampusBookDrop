    <div class="container my-5">
        <form action="/log_in" method="POST">
            <div class="row">
                <div class="col-12 col-md-6 offset-md-3 mb-5">
                    <h5 class="card-header fs-1">Enter OTP</h5>
                </div>

                <div class="col-12 col-md-6 offset-md-3 mb-5 form-floating">
                    <p class="text-center">OTP has been sent to your registered mobile number.</p>
                </div>
                <div class="col-12 mb-3 form-floating d-flex justify-content-center">
                    <div class="d-flex gap-2" style="width: 25rem;">
                        <input required type="number" class="form-control text-center" id="InputOtp" name="no1">
                        <input required type="number" class="form-control text-center" id="InputOtp" name="no2">
                        <input required type="number" class="form-control text-center" id="InputOtp" name="no3">
                        <input required type="number" class="form-control text-center" id="InputOtp" name="no4">
                        <input required type="number" class="form-control text-center" id="InputOtp" name="no5">
                        <input required type="number" class="form-control text-center" id="InputOtp" name="no6">
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12 col-md-6 offset-md-2 mb-3 d-flex flex-row-reverse">
                    <a href="#">Resend OTP?</a>
                </div>
                <div class="col-12 col-md-6 offset-md-3 mb-3 d-flex justify-content-evenly ">
                    <button class="btn btn-primary focus-button">Verify</button>
                    <a href="/" class="d-inline btn btn-primary">Cancel</a>
                </div>
            </div>
        </form>
    </div>
    <script src="/js/otp.js"></script>