<div class="card mt-2 mb-3">
    <div class="row">
        <div class="col-md-4">
            <img src="..." class="card-img-top" alt="...">
        </div>
        <div class="col-md-8">
            <div class="card-body">
                <h5 class="card-title">Product</h5>
                <p class="card-text">Some quick example text to build on the card title and make up the bulk of
                    the card's content.</p>
                <button type="button" class="btn btn-danger">Remove</button>
                <label for="qty" class="form-label">Qty</label>
                <button type="button" class="btn btn-primary increase-qty-btn">+</button>
                <input type="number" class="form-input input-qty" name="qty" id="qty" min="1" max="10" value="1">
                <button type="button" class="btn btn-primary decrease-qty-btn">-</button>
            </div>
        </div>
    </div>
</div>