<div class="d-grid my-3">
    <!-- <p class="text-center">Thumbnail</p> -->
    <img src="/resources/thumbnail.jpg" class="account-thumbnail mb-1" alt="">
    <a class="btn btn-primary edit-thumbnail my-2">Change</a>
</div>
<div class="account-details flex-column flex-md-row">
    <div class="col-auto">
        <label for="firstname" class="col-form-label">First Name</label>
        <input type="text" id="firstname" name="firstname" value="firstname" class="form-control">
    </div>
    <div class="">
        <label for="lastname" class="col-form-label">Last Name</label>
        <input type="text" id="lastname" name="lastname" value="lastname" class="form-control">
    </div>
</div>
<div class="account-details flex-column flex-md-row">
    <div class="">
        <label for="email" class="col-form-label">Email</label>
        <input type="email" id="email" name="email" value="goog@goog.com" class="form-control">
    </div>

    <div class="">
        <label for="mobile" class="col-form-label">Mobile</label>
        <input required type="tel" name="mobile" class="form-control" id="InputNumber" value="3456789023"
            pattern="[0-9]{10}" minlength="10" maxlength="10">
    </div>
</div>
<a class="btn btn-primary edit-thumbnail my-4">Edit Details</a>