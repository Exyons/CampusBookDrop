<div class="container-fluid mt-5 mb-2">
    <h4 class="text-white ms-4">Address <%= i+1 %> </h4>
    <div class="container address d-flex justify-content-center flex-row">
        <div class="container-sm-fluid flex-grow-1 mx-3 my-3 address-body">
            <div class="d-grid gap-0">
                <label for="name" class="form-label">Name</label>
                <input type="text" name="name" class="form-control" id="name" required>
            </div>
            <div class="d-grid gap-0">
                <label for="InputNumber" class="form-label text-start">Mobile</label>
                <input required type="tel" name="mobile" class="form-control" id="InputNumber" pattern="[0-9]{10}"
                    minlength="10" maxlength="10">
            </div>
            <div class="d-grid gap-0">
                <label for="room_no" class="form-label">Room Number</label>
                <input type="number" name="room_no" class="form-control mb-1" id="room_no" maxlength="3" required>
            </div>
            <div class="d-grid gap-0">
                <label for="hostel_name" class="form-label">Hostel</label>
                <select class="form-select" name="hostel_name" class="hostel_name" id="hostel_name" required>
                    <option value="TH">Tilak Hostel</option>
                    <option value="PH">Patel Hostel</option>
                    <option value="MH">Malviya Hostel</option>
                </select>
            </div>
            <div class="d-flex flex-column align-items-center my-2 ms-3">
                <a class="btn btn-primary edit-address my-4 flex-grow-0 ">Edit</a>
            </div>
        </div>

    </div>
</div>


