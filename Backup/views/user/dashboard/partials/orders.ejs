<div class="container order d-flex justify-content-center flex-column flex-md-row m-4">
    <div class="container-md-fluid d-flex justify-content-center my-2">
        <img src="/resources/thumbnail.jpg" alt="productImage">
    </div>
    <div class="flex-grow-1 mx-3 my-3">
        <div class="order-header">
            <p class="order-id">OrderId</p>
            <p class="order-status">Order Status</p>
        </div>
        <div class="order-details">
            <p class="product-name">Product Name</p>
            <p class="order-address">Address</p>
        </div>
        <div class="order-qty">
            <p class="date-time">order Date And Time</p>
            <p class="qty">Quantity: 1</p>
        </div>
    </div>
</div>

