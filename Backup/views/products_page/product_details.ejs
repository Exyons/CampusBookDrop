<% layout("layouts/boilerplate") -%>

    <div>
        <h1>
            <%= book.title %>
        </h1>
        <ul>
            <li>Description <%= book.description %>
            </li>
            <li>Price <%= book.price %>
            </li>
            <li>Semester <%= book.semester %>
            </li>
            <li>Useful in Year <%= book.year %>
            </li>
            <li>Programme <%= book.programme %>
            </li>
            <li>Branch <%= book.branch %>
            </li>
            <li>Available Quantity <%= book.qty %>
            </li>
        </ul>
    </div>

    