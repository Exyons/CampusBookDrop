<div class="col-md-6 col-lg-4 col-xxl-3 mb-4 custom-col">
    <div class="card shadow" style="width: 18rem;">
        <a href="/books/<%= product._id %>">
            <img src="/resources/photo.avif"  class="card-img-programme" alt="" width="100%">
        </a>
        <div class="card-body">
            <h5 class="card-title"><%= product.title %></h5>
            <p class="card-text"><%= product.description %></p>
            <p class="card-text">Price-<%= product.price %></p>
            <p class="card-text"> Tags- 
                <a href=""> <%= product.branch %> </a> 
                <a href=""> <%= product.programme %> </a>
            </p>
            <a href="#" class="btn buy-now-btn">Buy Now</a>
            <a href="#" class="btn add-to-cart-btn">Add To Cart</a>
        </div>
    </div>
</div>