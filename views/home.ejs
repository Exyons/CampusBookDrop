<% layout("layouts/boilerplate") -%>
    <main>
        <div id="myCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#myCarousel" data-bs-slide-to="0" class="active"
                    aria-current="true" aria-label="Slide 1"></button>
                <button type="button" data-bs-target="#myCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                <button type="button" data-bs-target="#myCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
            </div>
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <div class="carousel-img-container">
                        <img src="/images/join_our_team_1.png" class="carousel-img" alt="">
                    </div>
                    <div class="container">
                        <div class="carousel-caption text-dark text-start">
                            <h1 class="carousel-glass rounded-5">Join Our Team</h1>
                            <p class="carousel-glass rounded-5">
                                Want to lend a hand and make a difference for fellow
                                college students? <br> Join our team
                                of Book Heroes and
                                bring convenience straight to their doorstep! 
                            </p>
                            <p>
                                <a class="btn btn-lg carousel-content-btn join-us" href="/join_us">Join Us Today</a>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="carousel-item">
                    <div class="carousel-img-container">
                        <img src="/images/convinient_delivery_3.png" class="carousel-img" alt="">
                    </div>
                    <div class="container">
                        <div class="carousel-caption text-dark text-center">
                            <h1 class="carousel-glass rounded-5">Convenient Delivery</h1>
                            <p class="carousel-glass rounded-5">
                                Delivery service provided by our team is convenient for
                                both buyers and sellers.
                            </p>
                            <p>
                                <a class="btn btn-lg carousel-content-btn learn-more" href="/help">Learn more</a>
                            </p>
                        </div>
                    </div>
                </div>
                <div class="carousel-item">
                    <div class="carousel-img-container">
                        <img src="/images/books_collection_2.png" class="carousel-img" alt="">
                    </div>
                    <div class="container">
                        <div class="carousel-caption text-dark text-end">
                            <h1 class="carousel-glass rounded-5">Browse Our Collection of Books </h1>
                            <p class="carousel-glass rounded-5">Small collection now, growing bigger as more sellers
                                join. Affordable textbooks always
                                available!</p>
                            <p>
                                <a class="btn btn-lg carousel-content-btn browse-books" href="/books">Browse Books</a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#myCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#myCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>

        <div class="container marketing">
            <!-- START THE FEATURETTES -->
            <div class="row featurette">
                <div class="col-md-7">
                    <h2 class="featurette-heading fw-normal lh-1">Available 24/7</h2>
                    <h3 class="text-body-secondary">Sell or Buy Books Anytime</h3>
                    <p class="lead">Campus Book Drop is always available for your book needs.</p>
                </div>
                <div class="col-md-5">
                    <div class="container ">
                        <img src="/images/available_247_clock.png" class="ratio ratio-4x3 rounded-5" alt="">
                    </div>
                </div>
            </div>

            <div class="row featurette">
                <div class="col-md-7 order-md-2">
                    <h2 class="featurette-heading fw-normal lh-1">Why Choose Us?<h2>
                    <h3 class="text-body-secondary">We Have Designed The Website Specifically With You In Mind</h3>
                    <p class="lead">Having experienced the financial constraints and time limitations that come
                        with being a college student, We created this website with those challenges in mind.
                    </p>
                </div>
                <div class="col-md-5 order-md-1">
                    <div class="container rounded-5">
                        <img src="/images/college_students.png" class="ratio ratio-4x3 rounded-5" alt="">
                    </div>
                </div>
            </div>
        </div>
    </main>