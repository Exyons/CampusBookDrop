<% layout("layouts/boilerplate") -%>
    <h2 class="text-center mb-3">Place Order</h2>
<div class="container-fluid bg-body-tertiary">
    <div class="container position-content-container d-flex justify-content-center mb-3">
        <div class="address-position-container row my-3 w-75 p-3">
            <%- include("partials/address") %>
        </div>
        <div class="payment-postion-container container my-3 p-3">
            <%- include("partials/payment") %>
        </div>
        <div class="confirmation-postion-container container my-3">
            <%- include("partials/confirmation") %>
        </div>
    </div>
    <div class="container mt-4 mb-2 d-flex flex-column">
        <p class="lead text-center">We would love to deliver to your hostel/location, even if it's not on our
            list yet! </p>
        <p class="lead text-center">We're always looking to expand our reach and serve more students, so why
            not join our team and help us make that happen?</p>
        <p class="lead text-center">Just click on <a href="/help_us">"Help Us!"</a> and start your journey
            with us today.</p>
        <p class="lead text-center">We can't wait to work together with you!</p>
    </div>
</div>
<script src="/js/order_placing.min.js"></script>