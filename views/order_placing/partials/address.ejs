<% if (user.addresses.length) { %>
    <h3 class="text-center">Select an address</h3>
    <% user.addresses.forEach(address => { %>
        <div class="col-12 mb-3">
            <div class="card order-address-card" id="<%= address._id %>">
                <div class="card-header">
                    <!-- <a href="#" class="btn btn-primary">Select this Address</a> -->
                    <input class="form-check-input address-select-radio" type="radio" name="selectedAddress" id="<%= address._id %>">
                </div>
                <div class="card-body">
                    <h5 class="card-title"><%= address.name %></h5>
                    <p class="card-text"><%= address.mobile %></p>
                    <p class="card-text"><%= address.room %>, <%= address.hostel %></p>
                </div>
            </div>
        </div>
    <% }) %>
    <div class="container d-flex justify-content-center">
        <button class="btn btn-primary" id="addressCardCheckoutBtn">Checkout</button>
    </div>
<% } else { %>
    <div class="row">
        <h1 class="text-center">Add Address</h1>
        <p class="lead text-center">Where would you like us to deliver your order?</p>
        <form class="needs-validation" id="newOrderAddressForm" novalidate enctype="multipart/form-data">
            <div class="col-12 col-md-6 offset-md-3">
                <div class="mb-4 form-floating">
                    <input type="text" name="name" class="form-control" id="inputName"
                        placeholder="Name" required value="">
                    <label for="inputName" class="form-label">Name</label>
                </div>
                <div class="mb-4 form-floating">
                    <input required type="tel" name="mobile" class="form-control" id="inputNumber"
                        pattern="[0-9]{10}" minlength="10" maxlength="10" placeholder="Mobile Number"
                        value="">
                    <label for="inputNumber" class="form-label">Mobile Number</label>
                </div>
                <div class="mb-4 form-floating">
                    <input type="number" name="room" class="form-control" id="room" maxlength="3"
                        required placeholder="Room Number" value="">
                    <label for="room" class="form-label">Room Number</label>
                    <p class="text-end text-secondary">Max Room No. 750</p>
                </div>
                <div class="mb-4 form-floating">

                    <select class="form-select" name="hostel" class="hostle" id="hostel" required
                        placeholder="Slect Hostel" value="">
                        <option value="TH">Tilak Hostel</option>
                        <option value="PH">Patel Hostel</option>
                        <option value="MH">Malviya Hostel</option>
                    </select>
                    <label for="hostel_name" class="form-label">Select Hostel</label>
                </div>
            </div>
            <div class="d-flex justify-content-center">
                <button class="btn btn-primary" id="checkoutBtn">Checkout</button>
            </div>
        </form>
    </div>
    <script src="/js/validation_form.js"></script>
    <script src="/js/address_page.js"></script>
<% } %> 
    