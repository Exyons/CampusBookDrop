<div class="row">
    <div class="col-md-6 d-flex flex-column">
        <% books.forEach(book => { %>
            <div class="card mb-3 p-1" style="max-width: 540px;">
                <div class="row g-0">
                    <div class="col-4">
                        <% if (book.book.image) { %>
                            <img src="<%=book.book.image.url%>" class="card-img-programme ratio ratio-4x3" alt="">
                        <% } else {%>
                            <img src="/images/CampusBookDrop_Logo.png"  class="card-img-programme ratio ratio-4x3" alt="">
                        <% } %> 
                    </div>
                    <div class="col-8">
                        <div class="card-body">
                            <h5 class="card-title"> <%= book.book.title %> </h5>
                            <p class="card-text mb-2">&#8377; <%= book.book.price %></p>
                            <p class="card-text"> Qty: <%= book.cart_qty %></p>
                        </div>
                    </div>
                </div>
            </div>
        <% }) %> 
    </div>
    <div class="col-md-6">
        <div class="upi-payment-container container-sm">
            <h3>Scan the QR code</h3>
            <div class="qr-code-container container d-flex justify-content-center">
                <img src="/images/merchant_qr.png" alt="" class="img-thumbnail ratio ratio-4x3">
            </div>
            <form class="payment-done-reciept-form" id="paymentRecieptImageForm" enctype="multipart/form-data">
                <div class="mb-4">
                    <label for="image" class="form-label">Upload image of your payment receipt</label>
                    <div class="input-group mb-3">
                        <input type="file" class="form-control" name="reciept" id="paymentRecieptImage"
                            aria-describedby="paymentReciept" aria-label="Upload">
                    </div>
                </div>
            </form>
            <div class="progress-bar-container mb-3">
                <p class="upload-status-info"></p>
                <div class="progress" role="progressbar" aria-label="Info Animated striped example"
                    aria-valuenow="75" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-info"
                        style="width: 100%">
                    </div>
                </div>
            </div>
        </div>
        <div class="mb-3">
            <div class="d-flex justify-content-between">
                <p class="card-text">Subtotal</p>
                <p>&#8377; <span id="subtotal">0</span></p>
            </div>
            <div class="d-flex justify-content-between">
                <p class="card-text">Delivery Charge</p>
                <p>&#8377; <span id="deliveryCharge">0</span></p>
            </div>
            <div class="d-flex justify-content-between">
                <h3 class="card-text">Total Amount</h3>
                <h4>
                    <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="bi bi-currency-rupee rupee-icon-lg" viewBox="0 0 16 16">
                        <path d="M4 3.06h2.726c1.22 0 2.12.575 2.325 1.724H4v1.051h5.051C8.855 7.001 8 7.558 6.788 7.558H4v1.317L8.437 14h2.11L6.095 8.884h.855c2.316-.018 3.465-1.476 3.688-3.049H12V4.784h-1.345c-.08-.778-.357-1.335-.793-1.732H12V2H4v1.06Z"/>
                    </svg>
                    <span id="totalAmount">0</span>
                </h4>
            </div>
        </div>
        <div class="d-flex justify-content-center">
            <button class="btn btn-info mx-2" id="placeOrderBtn">Place Order</button>
            <a href="/books" class="btn btn-warning mx-2" id="cancelBtn">Cancel</a>
        </div>
    </div>
    
</div>