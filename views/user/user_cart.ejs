<% layout("layouts/no_footer_layout") -%>

    <div class="container-fluid bg-body-tertiary">
        <div class="container main-container d-flex flex-column-reverse justify-content-end justify-content-lg-center flex-lg-row min-vh-100 my-3">
            <div class="container product-container">

             <script>
                let productsLength = <%=products.length%>;
             </script>
                <% if (products.length > 0) { %>
                    <% products.forEach(product => { %>
                        <%- include("partials/cart_product", { product }) %> 
                    <% }) %>
                <% } %>

                <div class="card mt-2 mb-3 cart-empty-card shadow">
                    <div class="row">
                        <div class="col-md-8">
                            <div class="card-body">
                                <h5 class="card-title">Cart Empty</h5>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="container mb-3 cart-total">
                <div class="container">
                    <div class="card-body">
                        <h3 class="card-title">Summary</h3>
                        <div class="d-flex justify-content-between py-2">
                            <p class="card-text">Subtotal</p>
                            <p>&#8377; <span id="subtotal">0</span></p>
                        </div>
                        <div class="d-flex justify-content-between">
                            <p class="card-text">Delivery Charge</p>
                            <p>&#8377; <span id="deliveryCharge">0</span></p>
                        </div>
                        <div class="d-flex justify-content-between py-2 total-amount-container" id="">
                            <h3 class="card-text">Total Amount</h3>
                            <h4>
                                <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="bi bi-currency-rupee rupee-icon-lg" viewBox="0 0 16 16">
                                    <path d="M4 3.06h2.726c1.22 0 2.12.575 2.325 1.724H4v1.051h5.051C8.855 7.001 8 7.558 6.788 7.558H4v1.317L8.437 14h2.11L6.095 8.884h.855c2.316-.018 3.465-1.476 3.688-3.049H12V4.784h-1.345c-.08-.778-.357-1.335-.793-1.732H12V2H4v1.06Z"/>
                                </svg>
                                <span id="totalAmount">0</span>
                            </h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="container-fluid sticky-bottom text-center bg-light">
            <div class="container p-3">
                <h5 class="card-title mb-3"> <span class="no-of-products"></span> item(s) to order</h5>
                <div class="place-order-login-btn-container">
                    <% if (currentUser) { %>
                        <button class="btn mb-2" id="placeOrder">Place Order</button>
                    <% } else {%>
                        <a href="/user/log_in" class="btn mb-2" id="logIn">Log In</a>
                    <% } %> 
                </div>
                <div class="add-books-btn-container">
                    <a href="/books" class="btn mb-2" id="addBooks">Add Books</a>
                </div>
            </div>
        </div>
    </div>

    <script src="/js_min/user_cart.min.js"></script>