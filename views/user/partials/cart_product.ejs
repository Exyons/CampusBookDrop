<div class="card mt-2 mb-3 product-card" id="<%= product.product._id %>">
    <div class="row">
        <div class="col-md-4">
            <a href="/books/<%= product.product._id %>">
                <% if (product.product.image) { %>
                    <img src="<%=product.product.image.url%>" class="card-img-programme ratio ratio-4x3" alt="">
                <% } else {%>
                    <img src="/images/CampusBookDrop_Logo.png"  class="card-img-programme ratio ratio-4x3" alt="">
                <% } %>
            </a>
        </div>
        <div class="col-md-8 d-flex">
            <div class="card-body">
                <h5 class="card-title"><%= product.product.title %></h5>
                <h5 class="card-title">&#8377; <%= product.product.price %></h5>
                <div class="container mt-3 d-flex">
                    <div class="me-2 d-flex align-items-center">
                        Qty
                    </div>
                    <div class="border d-flex align-items-center rounded-2" id="<%= product.product._id %>">
                        <button type="button" class="increase-qty-btn qty-btn" id="<%= product.product._id %>">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-lg" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2Z"/>
                              </svg>
                        </button>
                        
                        <input type="number" class="form-input input-qty text-center mx-2 my-1" name="qty" id="qty" min="1" max="10" value="<%= product.cart_qty %>" disabled>
                    
                        <button type="button" class="decrease-qty-btn qty-btn" id="<%= product.product._id %>">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-dash-lg" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M2 8a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11A.5.5 0 0 1 2 8Z"/>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
            <div class="d-flex flex-column" id="<%= product.product._id %>">
                <button class="remove-btn" id="<%= product.product._id %>">&times;</button>
            </div>
        </div>
    </div>
</div>