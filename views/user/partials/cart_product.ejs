<div class="card mt-2 mb-3 product-card shadow" id="<%= product.product._id %>">
    <div class="row">
        <div class="col-md-4">
            <a href="/books/<%= product.product._id %>">
                <img src="/resources/photo.avif" class="img-fluid" alt="...">
            </a>
        </div>
        <div class="col-md-8 d-flex">
            <div class="card-body">
                <h5 class="card-title"><%= product.product.title %></h5>
                <p class="card-title">&#8377; <%= product.product.price %></p>
                <div class="container my-3 d-flex">
                    <p class="mx-3">Qty</p>
                    <div class="bg-body-tertiary" id="<%= product.product._id %>">
                        <button type="button" class="increase-qty-btn qty-btn fs-5" id="<%= product.product._id %>">+</button>
                        <input type="number" class="form-input input-qty" name="qty" id="qty" min="1" max="10" value="<%= product.cart_qty %>" disabled>
                        <button type="button" class="decrease-qty-btn qty-btn fs-5" id="<%= product.product._id %>">-</button>
                    </div>
                </div>
            </div>
            <div class="d-flex flex-column" id="<%= product.product._id %>">
                <button class="remove-btn" id="<%= product.product._id %>">&times;</button>
            </div>
        </div>
    </div>
</div>