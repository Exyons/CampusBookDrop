<% if(user.orders.length > 0) {%> 
    <% user.orders.forEach(order => {%> 
        <div class="container order-container my-3">
            <div class="card">
                <div class="header d-flex justify-content-between">
                    <div class="d-flex flex-column card-body"> 
                        <div class="d-flex flex-column flex-sm-row">
                            <h6 class="card-title order-id">Order Id: </h6>
                            <p class="card-text mt-0 mb-1 ms-2"><%= order.order_id %></p> 
                        </div>
                        <div class="d-flex flex-column flex-sm-row">
                            <h6 class="card-title order-status">Order Status: </h6>
                            <p class="card-text mt-0 mb-1 ms-2"><%= order.status[0].toUpperCase() + order.status.slice(1) %></p> 
                        </div>
                    </div>
                    <div class="show-receipt-btn my-2 mx-2">
                        <button class="teen-bindi" style="background: none; border: none;" id="<%=order.order_id%>">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-three-dots-vertical" viewBox="0 0 16 16">
                                <path d="M9.5 13a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm0-5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm0-5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/>
                            </svg>
                        </button>
                        <div class="teen-bindi-body shadow rounded-3" id="<%=order.order_id%>">
                            <a href="<%=order.receiptImage.url%>" class="btn btn-sm show-receipt-btn">Receipt</a>
                        </div>
                        
                        <% if (order.status === "confirmed") { %>
                            <button class="btn btm-sm btn-danger cancel-order-btn" >Cancel</button>
                        <% } %>
                        <% if (order.status === "delivered") { %>
                            <button class="btn btm-sm btn-info return-order-btn" >Return</button>
                        <% } %>
                    </div>
                </div>
                <% order.products.forEach(product => { %> 
                    <div class="card-body">
                        <div class="card mb-3">
                            <div class="row g-0">
                                <div class="col-sm-4">
                                    <% if (product.product.image) { %>
                                        <img src="<%= product.product.image.url %> " class="img-fluid rounded-start" alt="...">
                                    <% } else {%>
                                        <img src="/resources/photo.avif" class="img-fluid rounded-start" alt="...">
                                    <% } %> 
                                </div>
                                <div class="col-sm-8">
                                    <div class="card-body">
                                        <h5 class="card-title"><%= product.product.title %></h5>
                                        <p class="card-text"><%= product.product.description %></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
                <div class="accordion p-2" id="orderDetailsAccordian" >
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#<%=order.order_id%>AccordianBody" aria-expanded="true" aria-controls="collapseOne">
                            Show Details
                            </button>
                        </h2>
                    </div>
                    <div id="<%=order.order_id%>AccordianBody" class="accordion-collapse collapse" data-bs-parent="#orderDetailsAccordian">
                        <div class="accordion-body">
                            <% order.products.forEach(product => { %> 
                                <h5 class="card-title"><%= product.product.title %></h5>
                                <p class="card-text"><small>Price: <%= product.product.price %></small></p>
                                <p class="card-text"><small>Quantity: <%= product.order_qty %></small></p>
                            <% }) %> 
                            <div class="order-address">
                                <h6 class="card-title">Shipping Address:</h6>
                                <div class="d-flex flex-wrap">
                                    <p class="card-text ms-2"><%= order.address.name %>,</p>
                                    <p class="card-text ms-2"><%= order.address.mobile %>,</p>
                                    <p class="card-text ms-2"><%= order.address.room %>,
                                        <% if(order.address.hostel === "TH") {%> 
                                            <span>Tilak Hostel</span>
                                        <% } %> 
                                        <% if(order.address.hostel === "MH") {%> 
                                            <span>Malviya Hostel</span>
                                        <% } %> 
                                        <% if(order.address.hostel === "PH") {%> 
                                            <span>Patel Hostel</span>
                                        <% } %> 
                                    </p>
                                </div>
                            </div>
                            <div class="order-date">
                                <h6 class="card-title">Ordered On: </h6>
                                <% month = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]%>
                                <p class="card-text ms-2"><%= month[order.date.getMonth()] %>-<%= order.date.getDate() %>-<%=order.date.getFullYear() %></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    <% }) %> 
<% } else { %> 
    <div class="row my-3">
        <div class="col-12">
            <h4 class="text-center my-3">You have not Made any orders yet.</h4>
        </div>
        <div class="col-12 text-center">
            <a class="btn btn-success rounded-5" href="/books">Buy Books</a>
        </div>
    </div>
<% } %> 

