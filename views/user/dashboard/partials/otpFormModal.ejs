<div class="modal fade otp-form-modal" id="otpFormModal" data-bs-backdrop="static" data-bs-keyboard="false"
    tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header mb-3">
                <h1 class="modal-title otp-modal-title fs-5" id="staticBackdropLabel">Verify OTP</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <form class="needs-validation otp-form" novalidate enctype="multipart/form-data">
                        <p class="text-center mb-4" id="otpSendStatus">OTP has been sent to your email</p>
                        <div class="row justify-content-center">
                            <div class="col-8 form-floating mb-4">
                                <input required type="number" class="form-control text-center" id="inputOtp" name="otp"
                                    placeholder="Enter OTP">
                                <label for="inputOtp" class="ms-3">Enter OTP</label>
                            </div>
                        </div>

                        <div class="d-flex justify-content-center mb-4">
                            <button type="button" class="btn resend-otp-btn">Resend OTP?</button>
                        </div>
                        <div class="d-flex justify-content-center">
                            <button class="btn btn-primary verify-otp-btn">Verify</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

