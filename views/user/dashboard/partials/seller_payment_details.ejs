<div class="container my-3">
    <div class="row">
        <div class="card col-12 col-md-6 offset-md-3">
            <div class="card-body">
                <form action="/user/sellerPaymentDetails" method="POST" id="upiIdForm">
                    <div class="row">
                        <div class="col-12 form-floating mb-4">
                            <input type="text" class="form-control" id="sellerUPIid" name="sellerUPIid"
                                placeholder="Your UPI Id" value="<%= sellerUpiId %> ">
                            <label for="sellerUPIid" class="ms-3">Your UPI Id</label>
                        </div>
                        <div class="col-12 d-flex justify-content-center">
                            <button class="btn" id="saveUPIidBtn">Save</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>