<% if (sellerOrders[0].products.length) { %>
    <div class="alert alert-info received-order-info container-fluid text-center fs-5 rounded-5 mt-3" role="alert">
        <p>Just keep the below book(s) handy, and someone from Campus Book Drop will swing by to pick it up and deliver it for you.</p>
        <p>So sit back, relax, and let us handle the rest!</p>
    </div>
    <div class="container my-3">
        <% sellerOrders.forEach(order => { %>
            <div class="container bg-body-tertiary my-3">
                <div class="container-fluid my-4">
                    <h2 class="card-title text-center">Order Id: <%= order.orderId %></h2>
                </div>
                <div class="container d-flex justify-content-evenly flex-wrap">
                    <% order.products.forEach(product => { %>
                        <div class="card mb-3" style="width: 18rem;">
                            <% if (product.product.image) { %>
                                <img src="<%=product.product.image.url%>" class="card-img-programme ratio ratio-4x3" alt="">
                            <% } else {%>
                                <img src="/resources/photo.avif"  class="card-img-programme ratio ratio-4x3" alt="">
                            <% } %> 
                            <div class="card-body">
                                <div class="product-details">
                                    <h5 class="card-title"> <%= product.product.title %> </h5>
                                    <p class="card-text mb-2" id="price">Ordered Price: &#8377; <span><%= product.product.price %></span></p>
                                    <p class="card-text" id="tags">Ordered Qty: <span class="fs-5"><%= product.order_qty %></span> </p>
                                </div>
                            </div>
                            <div class="card-body">
                                <p class="card-text text-capitalize" id="tags">Current Status: <%= order.status %> </p>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% }) %>
    </div>
<% } else { %>
    <div class="row my-3">
        <div class="col-12 alert alert-info container-fluid text-center rounded-5 mt-3" role="alert">
			<h4 class="text-center my-3">Once a user purchases one of your books and the payment is confirmed, you'll receive the product details right here.</h4>
		</div>
    </div>
<% } %> 

