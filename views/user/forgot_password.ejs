<% layout("layouts/boilerplate") -%>

	<div class="container d-flex justify-content-center">
		<div class="row">
			<div class="col-12">
				<div class="card shadow p-4">
					<h3 class="card-title text-center my-3">Email Address Of Account</h3>
					<div class="card-body">
						<form action="/user/forgot_password" id="resetPasswordEmailForm" method="POST" class="needs-validation" novalidate>
							<div class="row">
								<div class="col-12 mb-4 form-floating">
                                    <input required type="email" name="email" class="form-control" id="InputEmail"
                                        placeholder="Enter Email">
                                    <label for="InputEmail" class="form-label ms-4">Enter Email</label>
                                    <!-- <div id="emailFeedback" class="text-center mt-2"></div> -->
                                </div>
							</div>
							<div class="d-grid gap-2">
								<button class="btn btn-primary" id="resetPasswordLnkBtn">Send Password Reset Link</button>
							</div>
						</form>
					</div>
				</div>
			</div>
		</div>
	</div>
	<script src="/js_min/forgot_password.min.js"></script>
	<script src="/js_min/validation_form.min.js"></script>