<% layout("layouts/no_footer_navbar") -%>

	<div class="container d-flex justify-content-center mt-5">
		<div class="card p-3">
			<div class="card-body">
				<form action="/user/forgot_password" id="resetPasswordEmailForm" method="POST" class="needs-validation"
					novalidate>
					<div class="row">
						<div class="col-12 mb-4 form-floating">
							<input required type="email" name="email" class="form-control" id="InputEmail"
								placeholder="Enter Email">
							<label for="InputEmail" class="form-label ms-2">Enter Email</label>
						</div>
					</div>
					<div class="d-grid gap-2">
						<button class="btn btn-primary" id="resetPasswordLnkBtn">Send Password Reset Link</button>
					</div>
				</form>
			</div>
		</div>
	</div>
	<script src="/js/forgot_password.min.js"></script>
	<script src="/js/validation_form.min.js"></script>