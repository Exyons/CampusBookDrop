<% layout("layouts/boilerplate") -%>
    <div class="container d-flex justify-content-center align-items-center">
        <div class="row">
            <div class="col-12 p-3">
                <div class="card shadow" style="max-width: 30em;">
                    <h1 class="text-center my-3">Change Password</h1>
                    <div class="card-body">
                        <form action="/user/sign_up" method="POST" class="needs-validation" id="passwordResetForm" novalidate>
                            <div class="row">
                                <input type="hidden" name="token" value="<%= token %>">
                                <div class="col-12 mb-2 form-floating password-container">
                                    <input required type="password" name="password" id="InputPassword"
                                        class="form-control" minlength="8" placeholder="New Password">
                                    <button type="button" onclick="togglePasswordVisibility()">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                            fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                                            <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z" />
                                            <path
                                                d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z" />
                                        </svg>
                                    </button>
                                    <label for="InputPassword" class="form-label ms-2">New Password</label>
                                </div>
                                <div id="passwordFeedback" class="text-center mb-4"></div>
                                <div class="col-12 mb-4 form-floating password-container">
                                    <input required type="password" name="confirmPassword" id="InputConfirmPassword"
                                        class="form-control" minlength="8" placeholder="Create Password">
                                    <button type="button" onclick="toggleConfirmPasswordVisibility()">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                            fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                                            <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z" />
                                            <path
                                                d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z" />
                                        </svg>
                                    </button>
                                    <label for="InputConfirmPassword" class="form-label ms-2">Confirm Password</label>
                                </div>
                            </div>
                            <div class="d-grid gap-2">
                                <button class="btn btn-success" id="resetPasswordBtn">Update</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="/js_min/validation_form.min.js"></script>
    <script src="/js_min/reset_password.min.js"></script>