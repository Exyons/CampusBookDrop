<% layout("layouts/no_footer_navbar") -%>
    <div class="container d-flex justify-content-center align-items-center mt-4">
        <div class="row">
            <div class="col-12 p-3">
                <div class="card" style="max-width: 30em;">
                    <h1 class="text-center my-3">Change Password</h1>
                    <div class="card-body">
                        <form action="/user/sign_up" method="POST" class="needs-validation" id="passwordResetForm" novalidate>
                            <div class="row">
                                <input type="hidden" name="token" value="<%= token %>">
                                <div class="col-12 mb-2 form-floating password-container">
                                    <input required type="password" name="password" id="newPassword"
                                        class="form-control" minlength="8" placeholder="New Password">
                                    <button type="button" id="newPasswordVisibilityBtn">
                                        <div class="d-block" id="newPasswordOpenEye">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                                                <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z"/>
                                                <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z"/>
                                            </svg>
                                        </div>
                                        <div class="d-none" id="newPasswordCloseEye">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-eye-slash-fill" viewBox="0 0 16 16">
                                                <path d="m10.79 12.912-1.614-1.615a3.5 3.5 0 0 1-4.474-4.474l-2.06-2.06C.938 6.278 0 8 0 8s3 5.5 8 5.5a7.029 7.029 0 0 0 2.79-.588zM5.21 3.088A7.028 7.028 0 0 1 8 2.5c5 0 8 5.5 8 5.5s-.939 1.721-2.641 3.238l-2.062-2.062a3.5 3.5 0 0 0-4.474-4.474L5.21 3.089z"/>
                                                <path d="M5.525 7.646a2.5 2.5 0 0 0 2.829 2.829l-2.83-2.829zm4.95.708-2.829-2.83a2.5 2.5 0 0 1 2.829 2.829zm3.171 6-12-12 .708-.708 12 12-.708.708z"/>
                                            </svg>
                                        </div>
                                    </button>
                                    <label for="newPassword" class="form-label ms-2">New Password</label>
                                </div>
                                <div id="passwordFeedback" class="text-center mb-4"></div>
                                <div class="col-12 mb-4 form-floating password-container">
                                    <input required type="password" name="confirmPassword" id="confirmPassword"
                                        class="form-control" minlength="8" placeholder="Create Password">
                                    <button type="button" id="confirmPasswordVisibilityBtn">
                                        <div class="d-block" id="confirmPasswordOpenEye">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                                                <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z"/>
                                                <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z"/>
                                            </svg>
                                        </div>
                                        <div class="d-none" id="confirmPasswordCloseEye">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-eye-slash-fill" viewBox="0 0 16 16">
                                                <path d="m10.79 12.912-1.614-1.615a3.5 3.5 0 0 1-4.474-4.474l-2.06-2.06C.938 6.278 0 8 0 8s3 5.5 8 5.5a7.029 7.029 0 0 0 2.79-.588zM5.21 3.088A7.028 7.028 0 0 1 8 2.5c5 0 8 5.5 8 5.5s-.939 1.721-2.641 3.238l-2.062-2.062a3.5 3.5 0 0 0-4.474-4.474L5.21 3.089z"/>
                                                <path d="M5.525 7.646a2.5 2.5 0 0 0 2.829 2.829l-2.83-2.829zm4.95.708-2.829-2.83a2.5 2.5 0 0 1 2.829 2.829zm3.171 6-12-12 .708-.708 12 12-.708.708z"/>
                                            </svg>
                                        </div>
                                    </button>
                                    <label for="confirmPassword" class="form-label ms-2">Confirm Password</label>
                                </div>
                            </div>
                            <div class="d-grid gap-2">
                                <button class="btn btn-success" id="resetPasswordBtn">Update</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="/js/validation_form.min.js"></script>
    <script src="/js/reset_password.min.js"></script>