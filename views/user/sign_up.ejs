<% layout("layouts/no_footer_navbar") -%>

<%- include("partials/otpFormModal") %>

		<div class="container d-flex justify-content-center mt-4">
			<div class="row">
				<div class="col-12" style="max-width: 30em;">
					<div class="card">
						<h1 class="text-center my-3">Create Account</h1>
						<div class="card-body">
							<form action="/user/sign_up" method="POST" class="needs-validation" id="signUpForm"
								novalidate>
								<div class="row">
									<div class="col-12 mb-4 form-floating">
										<input required type="text" name="firstname" class="form-control"
											id="InputFirstName" placeholder="First Name">
										<label for="InputFirstName" class="form-label ms-2">First Name &#x2217;</label>
									</div>

									<div class="col-12 mb-4 form-floating">
										<input required type="text" name="lastname" class="form-control"
											id="InputLastName" placeholder="Last Name">
										<label for="InputLastName" class="form-label ms-2">Last Name &#x2217;</label>
									</div>

									<div class="col-12 mb-4 form-floating">
										<input required type="text" name="username" class="form-control"
											id="InputUsername" placeholder="username">
										<label for="InputUsername" class="form-label ms-2">Username &#x2217;</label>
										<div id="usernameFeedback" class="text-center mt-2"></div>
									</div>

									<div class="col-12 mb-4 form-floating">
										<input required type="email" name="email" class="form-control" id="InputEmail"
											placeholder="Email">
										<label for="InputEmail" class="form-label ms-2">Email &#x2217;</label>
										<div id="emailFeedback" class="text-center mt-2"></div>
									</div>

									<div class="col-12 mb-4 form-floating">
										<input type="tel" name="mobile" class="form-control" id="InputNumber"
											pattern="[0-9]{10}" minlength="10" maxlength="10"
											placeholder="Mobile Number">
										<label for="InputNumber" class="form-label ms-2">Mobile Number</label>
									</div>

									<div class="col-12 mb-1 form-floating password-container">
										<input required type="password" name="password" id="InputPassword"
											class="form-control" minlength="8" placeholder="Create Password">
										<button type="button" id="passwordVisibilityBtn">
											<div class="d-block" id="openEye">
												<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
													<path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z"/>
													<path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z"/>
												</svg>
											</div>
											<div class="d-none" id="closeEye">
												<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-eye-slash-fill" viewBox="0 0 16 16">
													<path d="m10.79 12.912-1.614-1.615a3.5 3.5 0 0 1-4.474-4.474l-2.06-2.06C.938 6.278 0 8 0 8s3 5.5 8 5.5a7.029 7.029 0 0 0 2.79-.588zM5.21 3.088A7.028 7.028 0 0 1 8 2.5c5 0 8 5.5 8 5.5s-.939 1.721-2.641 3.238l-2.062-2.062a3.5 3.5 0 0 0-4.474-4.474L5.21 3.089z"/>
													<path d="M5.525 7.646a2.5 2.5 0 0 0 2.829 2.829l-2.83-2.829zm4.95.708-2.829-2.83a2.5 2.5 0 0 1 2.829 2.829zm3.171 6-12-12 .708-.708 12 12-.708.708z"/>
												</svg>
											</div>
										</button>
										<label for="InputPassword" class="form-label ms-2">Create Password &#x2217;</label>
										
									</div>
									<div id="passwordFeedback" class="text-center mb-4"></div>
								</div>
								<div class="d-grid gap-2">
									<button class="btn sign-up-btn d-flex justify-content-center" style="background-color: #4586fd; color: white;">
										<span id="signUpBtnText">Sign Up</span>
										<div class="spinner-border d-none" role="status" id="signUpBtnSpinner">
											<span class="visually-hidden">Loading...</span>
										</div>
									</button>
								</div>

								<div class="mt-5 mb-3 d-flex justify-content-center">
									<span>Already have an account?</span>
									<a href="/user/log_in" class="mx-2">Log In</a>
								</div>
							</form>
						</div>
					</div>
				</div>
			</div>
		</div>
		<script src="/js/sign_up.min.js"></script>
		<script src="/js/validation_form.min.js"></script>