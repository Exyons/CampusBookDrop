<% layout("layouts/boilerplate") -%>
    <main>
        <div class="container py-4">
            <div class="p-5 mb-4 bg-body-tertiary rounded-3">
                <div class="container-fluid py-5 ">
                    <div class="container row">
                        <div class="col-12 text-center mb-4">
                            <h1 class="display-5 fw-bold">Join us</h1>
                        </div>
                        <div class="col-12 col-md-6 offset-md-3">
                            <form action="/join_us" method="POST">
                                <div class="mb-4">
                                    <select class="form-select" name="helper_type" id="helper_type">
                                        <option value="seller">Become a seller</option>
                                        <option value="delivery">Help us with delivery</option>
                                    </select>
                                </div>
                                <div class="mt-4 mb-4 d-flex justify-content-center">
                                    <button class="btn" id="illHelpBtn">Yes, I will help.</button>
                                </div>
                            </form>
                        </div>
                        <div class="col-12">
                            <p class="fs-4 text-center">If you'd like to help out in any other way, please don't
                                hesitate to reach out to us. <br> We would love to hear from you!
                            </p>
                        </div>
                        <div class="col-12 d-flex justify-content-center">
                            <div class="mx-2">
                                <a class="link-body-emphasis link-offset-3 link-underline-opacity-0 link-underline-opacity-75-hover"
                                    href="#">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor"
                                        class="bi bi-linkedin" viewBox="0 0 16 16">
                                        <path
                                            d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854V1.146zm4.943 12.248V6.169H2.542v7.225h2.401zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248-.822 0-1.359.54-1.359 1.248 0 .694.521 1.248 1.327 1.248h.016zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016a5.54 5.54 0 0 1 .016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225h2.4z" />
                                    </svg>
                                </a>
                            </div>
                            <div class="mx-2">
                                <a class="link-body-emphasis link-offset-3 link-underline-opacity-0 link-underline-opacity-75-hover"
                                    href="#">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" class="bi bi-whatsapp" viewBox="0 0 16 16">
                                        <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
                                      </svg>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row align-items-md-stretch">
                <div class="col-lg-6  mb-3">
                    <div class="h-100 p-5 border rounded-3" id="sellBooksJumbotron">
                        <h2 class="fw-bold mb-3">Why Sell Your Books With Us?</h2>
                        <p>
                            Ready to declutter your bookshelf and earn some extra cash? Sell your books through us and
                            enjoy a
                            hassle-free experience that saves you time and money.
                        </p>
                        <p>
                            If you are looking to sell your used textbooks and help out your fellow college students?
                            You've come to the
                            right place! Our platform makes it easy to connect with buyers and get the most value out of
                            your books.
                        </p>
                        <p>
                            We know you're busy, and selling your old books can be a pain. But with our user-friendly
                            website and
                            dedicated support team, you can make the process simple and stress-free.
                            Plus, you'll be doing your part to
                            promote <span class="text-success">sustainability</span> and reduce waste on campus!
                        </p>
                    </div>
                </div>
                <div class="col-lg-6  mb-3">
                    <div class="h-100 p-5 border rounded-3" id="deliverBooksJumbotron">
                        <h2 class="fw-bold">Why Help Us Deliver?</h2>
                        <p><span class="fw-bold fs-6"> Gain Work Experience </span>
                            Joining our team of book couriers is an excellent opportunity
                            to gain valuable work experience that can help you build your resume and prepare for your
                            future career. As a book courier, you'll learn skills in logistics, customer service, and
                            time management that are highly sought after by employers. Join us today and start building
                            your skills while making a difference in your community!
                        </p>
                        <p><span class="fw-bold fs-6"> Flexible Schedule </span>
                            Our book courier position is flexible and can fit around your
                            class schedule.
                        </p>
                        <p><span class="fw-bold fs-6"> Network Building </span>
                            By becoming a book courier you will get the opportunity to
                            network with other students and potentially build connections for future career
                            opportunities.
                        </p>
                        <p><span class="fw-bold fs-6"> Community Involvement </span>
                            Joining as a book courier will not only save other college students money on textbooks but
                            also involve you in the local community, making a positive impact. It's a rewarding
                            experience that you wouldn't want to miss!
                        </p>
                        <p><span class="fw-bold fs-6"> Perks and Rewards </span>
                            Although we are not be able to offer monetary compensation, we can
                            consider offering other perks and rewards to you or your team of book couriers. For example,
                            we can offer discounts on textbooks sold
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </main>