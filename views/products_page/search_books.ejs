<% layout("layouts/boilerplate") -%>

    <div class="container d-flex flex-row-reverse">
        <button class="btn filter-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor"
                class="bi bi-three-dots-vertical" viewBox="0 0 16 16">
                <path
                    d="M9.5 13a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm0-5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm0-5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z" />
            </svg>
        </button>
    </div>
    
    <div class="container d-flex justify-content-center mb-3">
        <h2>Showing Results for: <%= query %> </h2>
    </div>

    <div class="container d-flex justify-content-center">
        <%- include("partials/filter_navbar") %>
    </div>
    
    <div class="album py-5 bg-body-tertiary">
        <div class="container">
            <div class="container">
                <!-- <%# if(pageProducts.length) {%>  -->
                    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3 product-card-container"></div>
                <!-- <%# } else { %> -->
                    <!-- <h2 calss="text-center">No Result Found</h2> -->
                <!-- <%# } %>   -->
            </div>
        </div>
        <div class="d-flex justify-content-center my-5 loading-symbol-container">
            <div class="spinner-grow text-secondary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    </div>

    <script src="/js_min/search_books.min.js"></script>