<% if (success && success.length) { %>
    <div class="container">
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <%= success %> 
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
<% } %>
<% if (error && error.length) { %>
    <div class="container">
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <%= error %> 
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
<% } %>


<!-- <button type="button" class="btn btn-primary" id="liveToastBtn1">Show live toast</button> -->

<div class="toast-container position-fixed start-50 translate-middle-x p-3 " style="top:100px">
	<div class="toast align-items-center text-bg-success border-0"  id="liveToastBody" role="alert" aria-live="assertive" aria-atomic="true">
		<div class="d-flex">
			<div class="toast-body">
				<span class="toast-body-text"></span>
			</div>
			<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
		</div>
	</div>
</div>