<div class="container-fluid navbar-container d-flex justify-content-center sticky-top">
    <nav class="navbar navbar-expand-lg rounded-5">
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
            aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse brand-logo-parent" id="navbarSupportedContent">
            <div class="navbar-nav nav-lnks">
                <a href="/" class="nav-link lnk home">Home</a>
                <div class="navbar-dropdown">
                    <div class="d-flex flex-start dropdown">
                        <a class="btn nav-link lnk" href="#" role="button" aria-expanded="false">
                            Items
                        </a>
                        <button type="button" class="btn dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="visually-hidden">Toggle Products Dropdown</span>
                        </button>
                        <ul class="dropdown-menu d-none"></ul>
                    </div>
                    <ul class="custom-dropdown-menu dropdown-menu d-none ms-sm-3">
                        <li><a class="nav-link lnk books" href="/books">Books</a></li>
                        <li><a class="nav-link lnk cycles" href="/#">Cycles</a></li>
                        <li><a class="nav-link lnk coolers" href="/#">Coolers</a></li>
                    </ul>
                </div>
                <a href="/join_us" class="nav-link lnk joinus">Join Us</a>
            </div>
            <div class="navbar-brand-logo">
                <a href="/" class="lnk d-none d-sm-block">
                    <img src="/images/CampusBookDrop_Logo_Small.png" class="brand-logo">
                </a>
                <a href="/" class="lnk d-block d-sm-none">
                    <img src="/images/CampusBookDrop_Icon_Cropped.png" class="brand-logo">
                </a>
            </div>
        </div>
        <div class="navbar-icons">
            <a class="search-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="20px" height="20px" fill="currentColor"
                    class="bi bi-search" viewBox="0 0 16 16">
                    <path
                        d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
            </a>

            <button class="btn user-icon" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasRight"
                aria-controls="offcanvasRight">
                <% if (currentUser && currentUser.image) { %>
                    <img src="<%= currentUser.image.url %>" alt="" width="30px" height="30px">
                <% } else {%>
                    <svg xmlns="http://www.w3.org/2000/svg" width="30px" height="30px" fill="currentColor"
                    class="bi bi-person" viewBox="0 0 16 16">
                        <path
                            d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0Zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4Zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10Z" />
                    </svg>
                <% } %> 
            </button>

            <a href="/user_cart" class="cart-icon position-relative">
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill"
                    id="cartItemCount" style="background-color: #EF2346;">
                    <span class="visually-hidden">cart length</span>
                </span>
                <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-cart mt-2"
                    viewBox="0 0 16 16">
                    <path
                        d="M0 2.5A.5.5 0 0 1 .5 2H2a.5.5 0 0 1 .485.379L2.89 4H14.5a.5.5 0 0 1 .485.621l-1.5 6A.5.5 0 0 1 13 11H4a.5.5 0 0 1-.485-.379L1.61 3H.5a.5.5 0 0 1-.5-.5zM3.14 5l1.25 5h8.22l1.25-5H3.14zM5 13a1 1 0 1 0 0 2 1 1 0 0 0 0-2zm-2 1a2 2 0 1 1 4 0 2 2 0 0 1-4 0zm9-1a1 1 0 1 0 0 2 1 1 0 0 0 0-2zm-2 1a2 2 0 1 1 4 0 2 2 0 0 1-4 0z" />
                </svg>
            </a>
        </div>
    </nav>
</div>

<div class="search-bar-container hidden mb-5">
    <div class="row">
        <div class="col-6 offset-3">
            <form action="/books/search" class="search-bar-form">
                <input type="text" name="q" class="search-bar form-control rounded-pill"
                    placeholder="Search">
            </form>
        </div>
    </div>
</div>

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasRight" aria-labelledby="offcanvasRightLabel">
    <div class="offcanvas-header">
        <div class="container-fluid d-flex justify-content-center">
            <% if(!currentUser) {%>
                <h4 class="offcanvas-title" id="offcanvasRightLabel">Hi!</h4>
            <% } else {%>
                <h4 class="offcanvas-title" id="offcanvasRightLabel">Howdy! <%=currentUser.username%></h4>
            <% } %>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <% if(!currentUser) {%>
            <div class="d-grid gap-2 col-6 mx-auto">
                <a href="/user/log_in" class="btn rounded-3 mb-3" id="userLogInBtn">Log In</a>
                <a href="/user/sign_up" class="btn rounded-3 mb-3" id="userSignUpBtn">Sign Up</a>
            </div>
        <% } else {%>
            <div class="d-grid gap-2 col-6 mx-auto">
                <a href="/user/dashboard" class="btn rounded-3 mb-3" id="userDashboardBtn" style="height: 40px; padding-top: 5px;">Your Dashboard</a>
                <form action="/user/log_out" method="POST" class="d-flex justify-content-center">
                    <button class="btn rounded-3 mb-3" id="userLogOutBtn">Log out</button>
                </form>
            </div>
        <% } %>
    </div>
</div>

<script src="/backup/og/js/navbar.js"></script>