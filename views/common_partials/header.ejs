<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>
        <%=title%>
    </title>
    <% if (title==="Welcome | Campus Book Drop" ) { %>
        <meta property="og:locale" content="en_US" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Campus Book Drop" />
        <meta property="og:title" content="Campus Book Drop - Buy and Sell Used Textbooks Online" />
        <meta property="og:description"
            content="An Online Store To Effortlessly Buy And Sell Used Textbooks. Connect With Other Students And Save Money!" />
        <meta property="og:image" content="https://www.campusbookdrop.store/images/CampusBookDrop_Logo.png" />
        <meta property="og:image:width" content="500" />
        <meta property="og:image:height" content="500" />
        <meta property="og:url" content="https://www.campusbookdrop.store" />
        <meta property="og:author" content="https://www.campusbookdrop.store" />

        <meta name="site_name" content="Campus Book Drop" />
        <meta name="title" content="Campus Book Drop - Buy and Sell Used Textbooks Online" />
        <meta name="description"
            content="Campus Book Drop is an online store for college students to effortlessly buy and sell their used textbooks. Connecting Students, Saving Money, Making College Life Easier!" />
        <meta name="robots" content="index, follow" />
        <meta name="keywords"
            content="online store, books, students, textbooks, buy books, sell books, coolers, cycles, campus, 
        Used books, College textbooks, Book exchange, Sell books online, Buy used books, Student marketplace, 
        Textbook reselling, Affordable books, Student savings, Book trading platform, Campus book sales, 
        Secondhand textbooks, Student book exchange, Cheap textbooks, Academic resources, Online platform for buying and selling used college textbooks,
        Student-to-student book exchange marketplace,Affordable secondhand books for college students,Convenient textbook resale platform for students,
        Reliable platform for trading pre-owned academic books,Easy and efficient way to sell and buy used textbooks,Money-saving options for purchasing college course materials,
        Sustainable approach to acquiring educational resources,Enhancing student affordability through textbook reselling,Connecting students to affordable academic materials,
        Accessible marketplace for student book transactions,Promoting financial sustainability in college education,Supporting student success with cost-effective textbooks,
        Encouraging the reuse and circulation of college books,Empowering students to monetize their unused textbooks" />
        
        <link rel="canonical" href="https://www.campusbookdrop.store">
        <script type="application/ld+json">
            {
              "@context" : "https://schema.org",
              "@type" : "WebSite",
              "name" : "Campus Book Drop",
              "alternateName" : "CampusBookDrop",
              "url" : "https://www.campusbookdrop.store/",
              "potentialAction": {
                "@type": "SearchAction",
                "target": {
                  "@type": "EntryPoint",
                  "urlTemplate": "https://www.campusbookdrop.store/books/search?q={search_term_string}"
                },
                "query-input": "required name=search_term_string"
              }
            }
        </script>

    <% } %>

    <% if (process.env.NODE_ENV==="production" ) { %>
        <link rel="preconnect" href="https://www.googletagmanager.com/gtag/js?id=REDACTED">
        <script async src="https://www.googletagmanager.com/gtag/js?id=REDACTED"
            fetchpriority="low"></script>
        <script fetchpriority="low">
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', 'REDACTED');
        </script>
    <% } %>

    <link rel="icon" type="image/png" href="/favicon.png" fetchpriority="high" />
    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css"
        fetchpriority="high">

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios@1.1.2/dist/axios.min.js" fetchpriority="high"
        defer></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.7/dist/umd/popper.min.js"
        fetchpriority="low" defer></script>
    <script src="/js/app.js" fetchpriority="high" defer></script>

    <link rel="stylesheet" href="/css/styles.css" fetchpriority="high">
    <link rel="stylesheet" href="/css/navbar_styles.css" fetchpriority="high">
    <link rel="stylesheet" href="/css/footer_styles.css" fetchpriority="high">

    <% if (page_styles) { %>
        <link rel="stylesheet" href="/css/<%= page_styles %>">
    <% } %>
</head>

<body class="d-flex flex-column min-vh-100">